{
  "name": "emporiosurfaces/es-smart-search",
  "description": "Smart product search plugin with matching, ranking and fuzzy matching",
  "version": "1.0.0",
  "autoload": {
    "psr-4": {
      "EsSmartSearch\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EsSmartSearch\\Tests\\": "tests/php/"
    }
  },
  "authors": [
    {
      "name": "Neil Williams",
      "email": "neil@tailormade.uk"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "brain/monkey": "^2.7"
  },
  "scripts": {
    "test": "@test:unit",
    "test:unit": "phpunit --configuration phpunit.xml.dist",
    "test:integration": "ESSS_INTEGRATION_TESTS=1 phpunit --configuration phpunit.integration.xml.dist"
  }
}
